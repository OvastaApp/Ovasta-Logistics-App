platform :ios, '15.0'

# The Firebase iOS SDK that GitLive 2.7.0 is built against (firebase-cocoapods in GitLive's own
# libs.versions.toml). Move it together with gitliveFirebase in gradle/libs.versions.toml.
firebase_version = '~> 11.8.0'

target 'iosApp' do
  use_frameworks!

  pod 'FirebaseCore', firebase_version
  pod 'FirebaseMessaging', firebase_version
  pod 'FirebaseCrashlytics', firebase_version
  # Linked for the GitLive Firebase SDK that :shared uses for Auth and Firestore
  pod 'FirebaseAuth', firebase_version
  pod 'FirebaseFirestore', firebase_version
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['GCC_NO_MODULE_VERIFIER'] = 'YES'
    end
  end
end
